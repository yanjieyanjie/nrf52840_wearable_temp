#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zephyr,display = &oled;
    };

    w1_0: w1 {
        compatible = "zephyr,w1-gpio";

        gpios = <&gpio0 6
                 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;


        status = "okay";

        ds18b20: ds18b20 {
            compatible = "maxim,ds18b20";

            family-code = <0x28>;
            resolution = <12>;

            status = "okay";
        };
    };
};

&i2c0 {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306";
        reg = <0x3c>;

        width = <128>;
        height = <64>;

        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;

        multiplex-ratio = <63>;

        segment-remap;
        com-invdir;

        prechargep = <0xF1>;

        ready-time-ms = <100>;

        status = "okay";
    };
};
